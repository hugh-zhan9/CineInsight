# 数据库后端。可选 sqlite / postgres。
#
# 不设置时按以下规则自动判定：
#   - PG_HOST 有值  -> postgres（现有安装升级后行为不变，仍连原来那个库）
#   - PG_HOST 为空  -> sqlite（新机器开箱即用，无需安装 PostgreSQL）
#
# 取值非法会直接启动失败并报出取值，不会静默回退——回退会让你以为连上了 A，
# 实际连的是 B。
# DB_BACKEND=sqlite

# SQLite 库文件路径，默认 ~/.video-master/library.db
# 注意：不会自动采用历史遗留的 ~/.video-master/video-master.db。
# SQLITE_PATH=/path/to/library.db

# 以下仅在 postgres 后端下使用
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=video_master
PG_SSLMODE=disable
# PG_TIMEZONE=Asia/Shanghai
